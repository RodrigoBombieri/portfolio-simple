---
import SectionHeader from "@components/ui/SectionHeader.astro";
import Icon from "@components/ui/Icon.astro";
import { ADVANTAGES } from "@data/whyChoose";
---

<section id="por-que-elegirme" class="band-soft relative border-y border-border-soft py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeader
      eyebrow="Por qué elegirme"
      title="Un desarrollador,"
      highlight="todo el compromiso de un equipo"
      description="Trabajo directo, sin intermediarios: cada decisión técnica está alineada con el resultado de negocio que buscas."
    />

    <div class="mt-10 grid grid-cols-1 divide-y divide-border-soft border-y border-border-soft sm:grid-cols-2 sm:divide-y-0 sm:divide-x lg:grid-cols-4">
      {
        ADVANTAGES.map((advantage, i) => (
          <div
            class="flex flex-col gap-4 px-6 py-8 first:pl-0 sm:px-8"
            data-animate
            style={`transition-delay:${i * 50}ms`}
          >
            <Icon name={advantage.icon} class="size-6 text-cyan" strokeWidth={1.5} />
            <h3 class="font-semibold text-ink">{advantage.title}</h3>
            <p class="text-sm leading-relaxed text-muted">{advantage.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
