---
import SectionHeader from "@components/ui/SectionHeader.astro";
import FaqItem from "@components/ui/FaqItem.astro";
import { FAQS } from "@data/faq";
import { SHOW_DRONES } from "@data/site";
---

<section id="faq" class="relative py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeader
      figure={SHOW_DRONES ? "04" : "03"}
      eyebrow="Preguntas frecuentes"
      title="Dudas"
      highlight="antes de empezar."
      description="Lo que más me preguntan antes de arrancar un proyecto."
    />

    <div class="mt-14 border-t border-line lg:ml-[calc(100%/12*2)]">
      {FAQS.map((faq, i) => <FaqItem faq={faq} index={i} />)}
    </div>
  </div>
</section>
