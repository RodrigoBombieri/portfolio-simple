---
import SectionHeader from "@components/ui/SectionHeader.astro";
import FaqItem from "@components/ui/FaqItem.astro";
import { FAQS } from "@data/faq";
---

<section id="faq" class="relative py-16 lg:py-24">
  <div class="mx-auto max-w-3xl px-6 lg:px-8">
    <SectionHeader
      eyebrow="Preguntas frecuentes"
      title="Dudas"
      highlight="antes de empezar"
      description="Lo que más me preguntan antes de arrancar un proyecto."
    />

    <div class="mt-10 flex flex-col gap-3">
      {FAQS.map((faq, i) => <FaqItem faq={faq} index={i} />)}
    </div>
  </div>
</section>
