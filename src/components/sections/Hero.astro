---
import Button from "@components/ui/Button.astro";
import Icon from "@components/ui/Icon.astro";
---

<section id="top" class="relative overflow-hidden pb-16 pt-32 lg:pb-20 lg:pt-40">
  <!-- fondo -->
  <div class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,black,transparent)]"></div>
  <div class="pointer-events-none absolute left-1/2 top-[-10%] size-[640px] -translate-x-1/2 rounded-full bg-primary/25 blur-[140px]"></div>
  <div class="pointer-events-none absolute right-[-10%] top-[20%] size-[420px] rounded-full bg-cyan/20 blur-[120px]"></div>

  <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-16 px-6 lg:grid-cols-2 lg:px-8">
    <div class="flex flex-col items-start gap-8">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-border bg-bg-elevated/60 px-4 py-1.5 text-xs font-medium text-muted"
        data-animate
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-cyan"></span>
        </span>
        Disponible para nuevos proyectos
      </span>

      <h1 class="text-balance text-4xl font-bold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-6xl" data-animate>
        Desarrollo software que
        <span class="text-gradient">impulsa tu negocio.</span>
      </h1>

      <p class="max-w-xl text-balance text-lg leading-relaxed text-muted" data-animate>
        Landing pages, aplicaciones web, software empresarial y soluciones para
        drones desarrolladas a medida — pensadas para ahorrarte tiempo, dinero
        y tareas repetitivas.
      </p>

      <div class="flex flex-col gap-4 sm:flex-row" data-animate>
        <Button href="#contacto" size="lg" icon="arrow-right">Cotizar mi proyecto</Button>
        <Button href="#servicios" variant="secondary" size="lg">Ver servicios</Button>
      </div>

      <div class="flex items-center gap-6 pt-4 text-sm text-muted-soft" data-animate>
        <div class="flex items-center gap-2">
          <Icon name="check" class="size-4 text-cyan" strokeWidth={2.25} />
          Código limpio y escalable
        </div>
        <div class="flex items-center gap-2">
          <Icon name="check" class="size-4 text-cyan" strokeWidth={2.25} />
          Comunicación directa
        </div>
      </div>
    </div>

    <!-- Mockup futurista -->
    <div class="relative mx-auto w-full max-w-lg" data-animate>
      <div class="animate-float relative rounded-3xl border border-border bg-bg-elevated/80 p-3 shadow-glow backdrop-blur-xl">
        <div class="flex items-center gap-1.5 border-b border-border-soft px-3 pb-3">
          <span class="size-2.5 rounded-full bg-red-400/70"></span>
          <span class="size-2.5 rounded-full bg-yellow-400/70"></span>
          <span class="size-2.5 rounded-full bg-green-400/70"></span>
          <span class="ml-3 text-xs text-muted-soft">app.dashboard.tsx</span>
        </div>

        <div class="grid grid-cols-3 gap-3 p-4">
          <div class="glass-card col-span-2 flex flex-col gap-3 rounded-xl p-4">
            <div class="flex items-center justify-between">
              <span class="text-xs text-muted-soft">Rendimiento</span>
              <span class="text-xs font-semibold text-cyan">+38%</span>
            </div>
            <div class="flex h-24 items-end gap-1.5">
              {
                [40, 65, 45, 80, 60, 95, 70].map((h) => (
                  <div
                    class="flex-1 rounded-t-md bg-linear-to-t from-primary to-cyan"
                    style={`height:${h}%`}
                  />
                ))
              }
            </div>
          </div>

          <div class="glass-card flex flex-col justify-between gap-2 rounded-xl p-4">
            <Icon name="cpu" class="size-5 text-cyan" />
            <div>
              <p class="text-lg font-bold text-ink">99.9%</p>
              <p class="text-[11px] text-muted-soft">Uptime</p>
            </div>
          </div>

          <div class="glass-card col-span-3 flex items-center justify-between rounded-xl p-4">
            <div class="flex items-center gap-3">
              <span class="flex size-9 items-center justify-center rounded-lg bg-primary/15 text-cyan">
                <Icon name="drone" class="size-5" />
              </span>
              <div>
                <p class="text-sm font-medium text-ink">Misión activa</p>
                <p class="text-[11px] text-muted-soft">Procesando telemetría en vivo</p>
              </div>
            </div>
            <span class="size-2 animate-pulse rounded-full bg-cyan"></span>
          </div>
        </div>
      </div>

      <div
        class="animate-float glass-card absolute -left-8 -top-6 flex items-center gap-2 rounded-xl px-4 py-2.5 text-xs font-medium text-ink shadow-glow-cyan"
        style="animation-delay:-2s"
      >
        <Icon name="check" class="size-4 text-cyan" strokeWidth={2.5} />
        Build exitoso
      </div>

      <div
        class="animate-float glass-card absolute -bottom-6 -right-4 flex items-center gap-2 rounded-xl px-4 py-2.5 text-xs font-medium text-ink shadow-glow"
        style="animation-delay:-4s"
      >
        <Icon name="rocket" class="size-4 text-primary-soft" />
        Deploy en producción
      </div>
    </div>
  </div>
</section>
