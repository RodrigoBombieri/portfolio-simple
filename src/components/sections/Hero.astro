---
import Button from "@components/ui/Button.astro";
import Icon from "@components/ui/Icon.astro";
import FigureLabel from "@components/ui/FigureLabel.astro";
import Annotation from "@components/ui/Annotation.astro";
import CornerMarks from "@components/ui/CornerMarks.astro";
import SystemScene from "@components/three/SystemScene.astro";
import { SITE, HERO, HERO_HEADLINES } from "@data/site";

const headline = HERO_HEADLINES[HERO.headlineIndex] ?? HERO_HEADLINES[0];
const card = HERO.card;

const rows = [
  { k: "Rol", v: `${SITE.role} Full Stack` },
  { k: "Stack", v: card.stack.join(" · ") },
  { k: "Base", v: card.base },
  { k: "Coord.", v: card.coords },
];
---

<section id="top" class="relative overflow-hidden pt-28 lg:pt-32">
  <!-- Retícula de plano -->
  <div class="reticle pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <!-- Fondo 3D (SystemScene): canvas en idle + fallback SVG -->
  <SystemScene />

  <div class="relative mx-auto grid max-w-7xl grid-cols-1 gap-14 px-6 pb-16 lg:grid-cols-12 lg:gap-8 lg:px-8 lg:pb-24 lg:pt-6">
    <div class="flex flex-col items-start gap-8 lg:col-span-7 lg:pt-6">
      <div class="flex w-full flex-col gap-3" data-animate>
        <FigureLabel n={HERO.figure} label={HERO.figureLabel} />
        <div class="h-px w-full max-w-md bg-line" data-draw></div>
      </div>

      <h1 class="display text-[clamp(2.5rem,5.6vw,5.75rem)] text-ink" data-reveal>
        {headline.map((line, i) => <span class:list={["block", { "text-muted": i > 0 }]}>{line}</span>)}
      </h1>

      <p class="max-w-xl text-pretty text-step-0 leading-relaxed text-muted sm:text-step-1 sm:leading-relaxed" data-animate>
        {HERO.description}
      </p>

      <div class="flex flex-col gap-5 sm:flex-row sm:items-center" data-animate>
        <div class="flex items-center">
          <Button href="#contacto" size="lg" icon="arrow-right">Cotizar mi proyecto</Button>
          <span class="hidden xl:inline-flex"><Annotation label="Punto de entrada" length={36} tone="signal" /></span>
        </div>
        <Button href="#servicios" variant="ghost" icon="arrow-right">Ver servicios</Button>
      </div>

      <ul class="mono-label-sm flex flex-wrap gap-x-8 gap-y-2 pt-2 text-muted" data-animate>
        {
          HERO.checks.map((check) => (
            <li class="flex items-center gap-2">
              <span class="size-1.5 bg-signal" aria-hidden="true"></span>
              {check}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Ficha técnica / sobre mí -->
    <div id="sobre-mi" class="relative lg:col-span-5 lg:col-start-8 lg:mt-14" data-animate>
      <div class="hidden pb-1 pl-[3.25rem] lg:block">
        <Annotation label={card.annotation} direction="down" length={22} />
      </div>
      <div class="sheet relative p-6 sm:p-8">
        <CornerMarks tone="signal" size={14} />

        <div class="mono-label-sm flex items-center justify-between gap-4 border-b border-line pb-4 text-muted">
          <span>{card.file}</span>
          <span class="flex items-center gap-2 text-ink">
            <span class="size-2 bg-signal" aria-hidden="true"></span>
            {card.status}
          </span>
        </div>

        <div class="mt-6 flex flex-col gap-6 sm:flex-row">
          <div class="relative h-fit w-36 shrink-0 self-center border border-line p-1.5 sm:self-start">
            <img
              src="/images/rodrigo.jpg"
              alt="Rodrigo Bombieri, desarrollador de software"
              width="144"
              height="180"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-4/5 w-full object-cover"
            />
          </div>
          <dl class="flex flex-1 flex-col divide-y divide-line-soft">
            {
              rows.map((row) => (
                <div class="flex flex-col gap-0.5 py-2 first:pt-0">
                  <dt class="mono-label-sm text-muted">{row.k}</dt>
                  <dd class="text-sm text-ink">{row.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <p class="mt-6 border-t border-line pt-5 text-sm leading-relaxed text-muted">{card.bio}</p>

        <div class="mono-label-sm mt-5 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-4">
          <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="link-draw inline-flex items-center gap-1.5 text-ink hover:text-signal" aria-label="GitHub de Rodrigo Bombieri">
            GitHub <Icon name="arrow-up-right" class="size-3" strokeWidth={1.5} />
          </a>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="link-draw inline-flex items-center gap-1.5 text-ink hover:text-signal" aria-label="LinkedIn de Rodrigo Bombieri">
            LinkedIn <Icon name="arrow-up-right" class="size-3" strokeWidth={1.5} />
          </a>
          <a href={`mailto:${SITE.email}`} class="link-draw inline-flex items-center gap-1.5 text-ink hover:text-signal" aria-label="Enviar email a Rodrigo Bombieri">
            Email <Icon name="arrow-up-right" class="size-3" strokeWidth={1.5} />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="ruler relative" aria-hidden="true"></div>
</section>
