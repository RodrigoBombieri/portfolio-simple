---
import SectionHeader from "@components/ui/SectionHeader.astro";
import ServiceRow from "@components/ui/ServiceRow.astro";
import Button from "@components/ui/Button.astro";
import { SERVICES } from "@data/services";
---

<section id="servicios" class="relative py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeader
      figure="01"
      eyebrow="Servicios"
      title="Módulos de software,"
      highlight="uno para cada etapa de tu negocio."
      description="Desde una landing que convierte hasta sistemas empresariales complejos: construyo exactamente lo que tu operación necesita."
    />

    <div class="mt-14 border-t border-line">
      {SERVICES.map((service, i) => <ServiceRow service={service} index={i} />)}
    </div>

    <div class="mt-10" data-animate>
      <Button href="/showroom" variant="ghost" icon="arrow-right">Ver ejemplos en el Showroom</Button>
    </div>
  </div>
</section>
