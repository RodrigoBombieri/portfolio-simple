---
import SectionHeader from "@components/ui/SectionHeader.astro";
import ProcessStep from "@components/ui/ProcessStep.astro";
import { PROCESS_STEPS } from "@data/process";
---

<section id="proceso" class="band-soft relative border-y border-line py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeader
      figure="02"
      eyebrow="Cómo trabajo"
      title="Un proceso claro,"
      highlight="de la primera conversación a producción."
      description="Cinco pasos para pasar de una conversación a software funcionando en tu negocio, con trato directo conmigo en cada etapa."
    />

    <!-- Circuito: horizontal en desktop, vertical en mobile -->
    <div class="relative mt-16" data-process-circuit>
      <!-- Pista y trazo de progreso (verde, controlado por scroll) -->
      <div class="absolute bottom-0 left-5 top-0 w-px bg-line md:bottom-auto md:left-0 md:right-0 md:top-5 md:h-px md:w-auto" aria-hidden="true"></div>
      <div
        class="process-progress absolute bottom-0 left-5 top-0 w-px bg-signal md:bottom-auto md:left-0 md:right-0 md:top-5 md:h-px md:w-auto"
        data-process-progress
        aria-hidden="true"
      ></div>

      <ol class="relative flex flex-col md:flex-row md:gap-2">
        {PROCESS_STEPS.map((step, i) => <ProcessStep step={step} index={i} total={PROCESS_STEPS.length} />)}
      </ol>
    </div>
  </div>
</section>
