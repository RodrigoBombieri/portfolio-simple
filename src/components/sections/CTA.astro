---
import Icon from "@components/ui/Icon.astro";
import FigureLabel from "@components/ui/FigureLabel.astro";
import CornerMarks from "@components/ui/CornerMarks.astro";
import { SITE, WHATSAPP_LINK, SHOW_DRONES } from "@data/site";

const channels = [
  { label: "WhatsApp", value: "Escribime directo", href: WHATSAPP_LINK, external: true, primary: true },
  { label: "Email", value: SITE.email, href: `mailto:${SITE.email}`, external: false, primary: false },
  { label: "GitHub", value: "RodrigoBombieri", href: SITE.github, external: true, primary: false },
  { label: "LinkedIn", value: "rodrigobombieri-dev", href: SITE.linkedin, external: true, primary: false },
];
const figure = SHOW_DRONES ? "05" : "04";
---

<section id="contacto" class="relative border-t border-line py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex flex-col gap-3" data-animate>
      <FigureLabel n={figure} label="Iniciar especificación" />
      <div class="h-px w-full bg-line" data-draw></div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="flex flex-col gap-7 lg:col-span-5">
        <h2 class="display text-[clamp(1.9rem,8.6vw,2.594rem)] text-ink sm:text-step-5" data-reveal>
          Contame qué necesitás.
          <span class="text-muted">Te respondo yo.</span>
        </h2>
        <p class="text-pretty leading-relaxed text-muted" data-animate>
          Escribime en pocas líneas qué querés resolver y te devuelvo una propuesta clara, sin compromiso. Sin
          intermediarios: hablás conmigo desde el primer mensaje.
        </p>

        <ul class="mt-2 flex flex-col border-t border-line" data-animate>
          {
            channels.map((channel) => (
              <li class="border-b border-line">
                <a
                  href={channel.href}
                  target={channel.external ? "_blank" : undefined}
                  rel={channel.external ? "noopener noreferrer" : undefined}
                  class:list={[
                    "group flex items-center justify-between gap-4 py-4 transition-colors",
                    channel.primary ? "text-signal" : "text-ink hover:text-signal",
                  ]}
                >
                  <span class="flex flex-col">
                    <span class="mono-label-sm text-muted">{channel.label}</span>
                    <span class:list={["text-base", { "font-semibold": channel.primary }]}>{channel.value}</span>
                  </span>
                  <Icon name="arrow-up-right" class="btn-tick size-5" strokeWidth={1.5} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <form
        class="sheet relative flex flex-col gap-7 p-6 sm:p-9 lg:col-span-6 lg:col-start-7"
        data-contact-form
        data-endpoint={SITE.formEndpoint}
        data-animate
      >
        <CornerMarks tone="signal" size={14} />
        <p class="mono-label-sm text-muted">Formulario de solicitud · todos los campos son obligatorios</p>

        <div class="flex flex-col gap-1">
          <label for="name" class="mono-label-sm text-muted">01 · Nombre</label>
          <input id="name" name="name" type="text" required autocomplete="name" class="field" placeholder="Tu nombre" />
        </div>

        <div class="flex flex-col gap-1">
          <label for="email" class="mono-label-sm text-muted">02 · Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="field" placeholder="tu@empresa.com" />
        </div>

        <div class="flex flex-col gap-1">
          <label for="project-type" class="mono-label-sm text-muted">03 · Tipo de proyecto</label>
          <select id="project-type" name="projectType" required class="field">
            <option value="" selected disabled>Elegí una opción</option>
            <option value="Landing Page">Landing Page</option>
            <option value="Aplicación Web">Aplicación Web</option>
            <option value="Aplicación de Escritorio">Aplicación de Escritorio</option>
            {SHOW_DRONES && <option value="Software para Drones">Software para Drones (Experimental)</option>}
            <option value="Otro">Otro</option>
          </select>
        </div>

        <div class="flex flex-col gap-1">
          <label for="message" class="mono-label-sm text-muted">04 · Contame sobre tu proyecto</label>
          <textarea id="message" name="message" rows="4" required class="field resize-none" placeholder="Necesito..."></textarea>
        </div>

        <button
          type="submit"
          class="group mt-1 inline-flex items-center justify-between gap-3 rounded-xs bg-signal px-6 py-4 text-base font-medium text-bg transition-colors hover:bg-ink disabled:opacity-60"
        >
          Enviar solicitud
          <Icon name="arrow-right" class="btn-tick size-5" strokeWidth={1.5} />
        </button>

        <p class="mono-label-sm min-h-4 text-center text-muted" data-form-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
