---
import FigureLabel from "@components/ui/FigureLabel.astro";

export interface Props {
  figure: string;
  eyebrow: string;
  title: string;
  /** Segunda parte del título, en gris (no usa degradados). */
  highlight?: string;
  description?: string;
  as?: "h1" | "h2";
}

const { figure, eyebrow, title, highlight, description, as: Tag = "h2" } = Astro.props;
---

<div class="flex flex-col gap-6">
  <div class="flex flex-col gap-3" data-animate>
    <FigureLabel n={figure} label={eyebrow} />
    <div class="h-px w-full bg-line" data-draw></div>
  </div>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-10">
    <Tag class="display text-[clamp(1.9rem,8.6vw,2.594rem)] text-ink sm:text-step-5 lg:col-span-7" data-reveal>
      {title}{" "}
      {highlight && <span class="text-muted">{highlight}</span>}
    </Tag>
    {
      description && (
        <p class="text-pretty leading-relaxed text-muted lg:col-span-4 lg:col-start-9 lg:self-end" data-animate>
          {description}
        </p>
      )
    }
  </div>
</div>
