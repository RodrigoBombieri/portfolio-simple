---
// Cajetín de plano: celdas tipo tabla con metadatos.
export interface Cell {
  k: string;
  v: string;
  href?: string;
  wide?: boolean;
}
export interface Props {
  cells: Cell[];
  class?: string;
}
const { cells, class: className = "" } = Astro.props;
---

<dl class={`grid grid-cols-2 border-l border-t border-line md:grid-cols-7 ${className}`}>
  {
    cells.map((cell) => (
      <div
        class:list={[
          "flex flex-col gap-1 border-b border-r border-line px-4 py-3",
          cell.wide ? "col-span-2 md:col-span-2" : "",
        ]}
      >
        <dt class="mono-label-sm text-muted">{cell.k}</dt>
        <dd class="mono-label text-ink">
          {cell.href ? (
            <a href={cell.href} class="link-draw">
              {cell.v}
            </a>
          ) : (
            cell.v
          )}
        </dd>
      </div>
    ))
  }
</dl>
