---
// Etiqueta rectangular para contenido en fase experimental (Drones y similares).
export interface Props {
  class?: string;
  /** Versión corta ("BETA") pensada para el nav. */
  compact?: boolean;
}

const { class: className = "", compact = false } = Astro.props;
---

<span
  class:list={[
    "mono-label-sm inline-flex w-fit items-center border border-warn px-1.5 py-0.5 leading-none text-warn",
    className,
  ]}
  title="Contenido en fase experimental, aún no disponible como producto 100% cerrado"
>
  {compact ? "Beta" : "Beta / Experimental"}
</span>
