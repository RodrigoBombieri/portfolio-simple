---
import type { Tech } from "@data/tech";

export interface Props {
  tech: Tech;
}

const { tech } = Astro.props;
---

<span
  class="inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-bg-elevated/60 px-5 py-2.5 text-sm font-medium text-muted transition-colors duration-300 hover:border-primary/50 hover:text-ink"
>
  <span class="size-1.5 rounded-full bg-cyan"></span>
  {tech.name}
</span>
