---
import Dimension from "@components/ui/Dimension.astro";
import type { ProcessStepData } from "@data/process";

export interface Props {
  step: ProcessStepData;
  index: number;
  total: number;
}

const { step } = Astro.props;
---

<li class="relative flex flex-1 gap-5 pb-10 md:flex-col md:gap-6 md:pb-0 md:pr-6" data-animate>
  <!-- Nodo del circuito -->
  <span
    class="mono-label relative z-10 flex size-10 shrink-0 items-center justify-center border border-line bg-bg text-muted transition-colors duration-500 data-[active=true]:border-signal data-[active=true]:text-signal"
    data-process-node
    data-active="false"
  >
    {step.number}
  </span>

  <div class="flex flex-col gap-3 md:flex-1">
    <h3 class="display-md text-step-1 text-ink">{step.title}</h3>
    <p class="text-sm leading-relaxed text-muted">{step.description}</p>
    {
      step.advantage && (
        <p class="mono-label-sm flex items-center gap-2 text-muted">
          <span class="size-1.5 shrink-0 bg-signal" aria-hidden="true" />
          {step.advantage}
        </p>
      )
    }
    {step.metric && <Dimension label={step.metric} class="mt-auto pt-2" />}
  </div>
</li>
