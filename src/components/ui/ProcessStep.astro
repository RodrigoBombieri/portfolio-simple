---
import Icon from "@components/ui/Icon.astro";
import type { ProcessStepData } from "@data/process";

export interface Props {
  step: ProcessStepData;
  index: number;
  total: number;
}

const { step, index, total } = Astro.props;
const isLast = index === total - 1;
---

<div class="relative flex flex-1 flex-col items-center gap-5 text-center" data-animate style={`transition-delay:${index * 100}ms`}>
  {
    !isLast && (
      <div class="absolute left-1/2 top-8 hidden h-px w-full -translate-y-1/2 overflow-hidden md:block">
        <div
          class="h-full w-full origin-left scale-x-0 bg-linear-to-r from-primary to-cyan"
          data-process-line
        />
      </div>
    )
  }

  <div
    class="relative z-10 flex size-16 items-center justify-center rounded-2xl border border-border bg-bg-elevated text-cyan shadow-glow"
  >
    <Icon name={step.icon} class="size-7" />
    <span
      class="absolute -right-2 -top-2 flex size-6 items-center justify-center rounded-full bg-linear-to-br from-primary to-cyan text-[11px] font-bold text-white"
    >
      {step.number}
    </span>
  </div>

  <div class="flex flex-col gap-1.5 px-2">
    <h3 class="font-semibold text-ink">{step.title}</h3>
    <p class="text-sm leading-relaxed text-muted">{step.description}</p>
  </div>
</div>
