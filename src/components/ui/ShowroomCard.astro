---
import CornerMarks from "@components/ui/CornerMarks.astro";
import Dimension from "@components/ui/Dimension.astro";
import type { ShowroomItem } from "@data/showroom";

export interface Props {
  item: ShowroomItem;
  /** Número correlativo de lámina en todo el showroom. */
  n: number;
  categoryId: string;
  categoryTag: string;
}

const { item, n, categoryId, categoryTag } = Astro.props;
const isEmbed = Boolean(item.embed);
const code = `LÁM. ${String(n).padStart(2, "0")}`;

// La card usa el aspect-ratio real del mockup para que las piezas mobile (retrato) se
// vean altas y angostas. En categorías "anchas" (diseños >= 1000px) se limita el ratio
// a un mínimo (MIN_WIDE_RATIO) para que las cards de una misma fila queden parejas: el
// iframe del thumbnail se monta a su tamaño real (mockupEmbeds.ts) y overflow-hidden
// recorta el resto. Al abrir el modal se ve el mockup completo con su proporción real
// (data-w/data-h conservan los valores verdaderos, sin clamping).
const MIN_WIDE_RATIO = 1.3;
const rawRatio = isEmbed ? item.embed!.width / item.embed!.height : 1;
const isWide = isEmbed && item.embed!.width >= 1000;
const cardRatio = isWide ? Math.max(rawRatio, MIN_WIDE_RATIO) : rawRatio;
---

<article class="group flex flex-col gap-3" data-lamina data-category={categoryId} data-animate>
  <header class="mono-label-sm flex items-center justify-between text-muted">
    <span class="text-signal">{code}</span>
    <span class="flex items-center gap-2">
      {isEmbed && (
        <span class="flex items-center gap-1.5 text-ink">
          <span class="size-1.5 bg-signal" aria-hidden="true" />
          Vivo
        </span>
      )}
      <span>{categoryTag}</span>
    </span>
  </header>

  <div class="relative border border-line bg-bg-soft p-1.5 transition-colors duration-300 group-hover:border-signal-dim">
    <CornerMarks tone="signal" size={10} />
    {
      isEmbed ? (
        <button
          type="button"
          class="relative block w-full cursor-pointer overflow-hidden bg-bg text-left"
          style={`aspect-ratio:${cardRatio}`}
          data-mockup-open
          data-src={item.embed!.src}
          data-title={item.title}
          data-w={item.embed!.width}
          data-h={item.embed!.height}
          aria-label={`Abrir vista interactiva de ${item.title}`}
        >
          <div
            class="absolute inset-0"
            data-mockup-thumb
            data-src={item.embed!.src}
            data-w={item.embed!.width}
            data-h={item.embed!.height}
          >
            <div class="absolute inset-0 flex items-center justify-center" data-mockup-skeleton>
              <span class="mono-label-sm text-muted">Cargando lámina…</span>
            </div>
          </div>

          <div class="absolute inset-0 z-10 flex items-end justify-start bg-bg/0 p-3 opacity-0 transition-all duration-300 group-hover:bg-bg/55 group-hover:opacity-100">
            <span class="mono-label bg-signal px-3 py-1.5 text-bg">Ver interactivo →</span>
          </div>
        </button>
      ) : (
        <div class="relative aspect-video overflow-hidden bg-bg">
          <img
            src={item.image}
            alt={`Captura de ${item.title}`}
            loading="lazy"
            decoding="async"
            width="640"
            height="360"
            class="h-full w-full object-cover"
            onerror="this.style.display='none'"
          />
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-2">
    <h3 class="display-md text-step-1 text-ink">{item.title}</h3>
    <p class="text-sm leading-relaxed text-muted">{item.description}</p>
  </div>

  {isEmbed && <Dimension label={`${item.embed!.width} × ${item.embed!.height} px`} class="mt-1" />}
</article>
