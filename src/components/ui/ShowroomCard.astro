---
import type { ShowroomItem } from "@data/showroom";

export interface Props {
  item: ShowroomItem;
  index?: number;
}

const { item, index = 0 } = Astro.props;
const isEmbed = Boolean(item.embed);
---

<article
  class="group relative flex flex-col overflow-hidden rounded-3xl border border-border bg-bg-elevated/60 transition-all duration-500 hover:-translate-y-1.5 hover:border-primary/40 hover:shadow-glow"
  data-animate
  style={`transition-delay:${index * 60}ms`}
>
  {
    isEmbed ? (
      <button
        type="button"
        class="relative aspect-video w-full cursor-pointer overflow-hidden bg-bg-soft text-left"
        data-mockup-open
        data-src={item.embed!.src}
        data-title={item.title}
        aria-label={`Abrir vista interactiva de ${item.title}`}
      >
        <div
          class="absolute inset-0"
          data-mockup-thumb
          data-src={item.embed!.src}
          data-w={item.embed!.width}
          data-h={item.embed!.height}
        >
          <div class="absolute inset-0 flex items-center justify-center gap-1.5" data-mockup-skeleton>
            <span class="size-1.5 animate-bounce rounded-full bg-cyan [animation-delay:-0.3s]" />
            <span class="size-1.5 animate-bounce rounded-full bg-cyan [animation-delay:-0.15s]" />
            <span class="size-1.5 animate-bounce rounded-full bg-cyan" />
          </div>
        </div>

        <div class="absolute left-3 top-3 z-10 flex items-center gap-1.5 rounded-full border border-border bg-bg/70 px-2.5 py-1 text-[11px] font-medium text-muted backdrop-blur">
          <span class="size-1.5 rounded-full bg-emerald-400 shadow-[0_0_0_3px_rgba(52,211,153,0.25)]" />
          Vivo
        </div>

        <div class="absolute inset-0 flex items-center justify-center bg-linear-to-t from-bg via-bg/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
          <span class="translate-y-1.5 rounded-full bg-ink px-4 py-2 text-xs font-semibold text-bg transition-transform duration-300 group-hover:translate-y-0">
            Ver interactivo →
          </span>
        </div>
      </button>
    ) : (
      <div class="relative aspect-video overflow-hidden bg-bg-soft">
        <img
          src={item.image}
          alt={`Captura de ${item.title}`}
          loading="lazy"
          decoding="async"
          width="640"
          height="360"
          class="h-full w-full scale-100 object-cover opacity-90 transition-all duration-700 group-hover:scale-110 group-hover:opacity-100"
          onerror="this.style.display='none'"
        />
        <div class="absolute inset-0 bg-linear-to-t from-bg via-bg/10 to-transparent opacity-80 transition-opacity duration-500 group-hover:opacity-40" />
      </div>
    )
  }

  <div class="flex flex-1 flex-col gap-2 p-6">
    <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
    <p class="text-sm leading-relaxed text-muted">{item.description}</p>
  </div>
</article>
