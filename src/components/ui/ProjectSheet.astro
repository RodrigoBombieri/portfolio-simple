---
import Icon from "@components/ui/Icon.astro";
import CornerMarks from "@components/ui/CornerMarks.astro";
import ExperimentalBadge from "@components/ui/ExperimentalBadge.astro";
import type { Project } from "@data/projects";

export interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const code = String(index + 1).padStart(2, "0");
---

<article class="grid grid-cols-1 gap-8 border-t border-line py-10 lg:grid-cols-12 lg:gap-10 lg:py-12" data-animate>
  <!-- Captura -->
  <div class="flex flex-col gap-3 lg:col-span-5">
    <p class="mono-label-sm flex items-center justify-between text-muted">
      <span class="text-signal">FICHA {code}</span>
      <span>{project.category}</span>
    </p>
    <div class="relative border border-line bg-bg-soft p-1.5">
      <CornerMarks tone="signal" size={12} />
      <div class="relative aspect-video overflow-hidden bg-bg">
        <img
          src={project.image}
          alt={`Captura del proyecto ${project.title} (${project.category}), desarrollado con ${project.tags.join(", ")}`}
          loading="lazy"
          decoding="async"
          width="640"
          height="360"
          class="h-full w-full object-cover"
          onerror="this.style.display='none'"
        />
      </div>
    </div>
  </div>

  <!-- Datos -->
  <div class="flex flex-col gap-6 lg:col-span-7">
    <div class="flex flex-wrap items-center gap-3">
      <h3 class="display-md text-step-3 text-ink">{project.title}</h3>
      {project.experimental && <ExperimentalBadge />}
    </div>

    <dl class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
      <div class="flex flex-col gap-1.5 sm:col-span-2">
        <dt class="mono-label-sm text-muted">Alcance</dt>
        <dd class="text-muted leading-relaxed text-ink/90">{project.description}</dd>
      </div>
      {
        project.problem && (
          <div class="flex flex-col gap-1.5">
            <dt class="mono-label-sm text-muted">Problema</dt>
            <dd class="text-sm leading-relaxed text-ink/90">{project.problem}</dd>
          </div>
        )
      }
      {
        project.solution && (
          <div class="flex flex-col gap-1.5">
            <dt class="mono-label-sm text-muted">Solución</dt>
            <dd class="text-sm leading-relaxed text-ink/90">{project.solution}</dd>
          </div>
        )
      }
      {
        project.decisions && project.decisions.length > 0 && (
          <div class="flex flex-col gap-2 sm:col-span-2">
            <dt class="mono-label-sm text-muted">Decisiones técnicas</dt>
            <dd>
              <ul class="flex flex-col gap-1.5 text-sm text-ink/90">
                {project.decisions.map((d) => (
                  <li class="flex gap-3">
                    <span class="mt-2 size-1.5 shrink-0 bg-signal" aria-hidden="true" />
                    {d}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        )
      }
    </dl>

    <!-- Mini diagrama: capas del stack -->
    <div class="flex flex-col gap-2">
      <p class="mono-label-sm text-muted">Capas del stack</p>
      <div class="flex flex-wrap items-center gap-y-2" role="list" aria-label={`Stack de ${project.title}`}>
        {
          project.tags.map((tag, i) => (
            <>
              <span role="listitem" class="mono-label-sm border border-line px-3 py-2 text-ink">{tag}</span>
              {i < project.tags.length - 1 && <span aria-hidden="true" class="h-px w-5 bg-signal-dim sm:w-8" />}
            </>
          ))
        }
      </div>
    </div>

    {
      project.url && (
        <div>
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver repositorio de ${project.title} en GitHub`}
            class="group mono-label inline-flex items-center gap-2 text-signal"
          >
            <span class="link-draw pb-0.5">Ver código en GitHub</span>
            <Icon name="arrow-up-right" class="btn-tick size-4" strokeWidth={1.5} />
          </a>
        </div>
      )
    }
  </div>
</article>
