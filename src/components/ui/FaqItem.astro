---
import Icon from "@components/ui/Icon.astro";
import type { FaqEntry } from "@data/faq";

export interface Props {
  faq: FaqEntry;
  index?: number;
}

const { faq, index = 0 } = Astro.props;
---

<details
  class="group rounded-2xl border border-border bg-bg-elevated/40 px-6 py-5 transition-colors duration-300 open:border-cyan/40"
  data-animate
  style={`transition-delay:${index * 50}ms`}
>
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden">
    {faq.question}
    <Icon
      name="chevron-down"
      class="size-5 shrink-0 text-cyan transition-transform duration-300 group-open:rotate-180"
      strokeWidth={2}
    />
  </summary>
  <p class="mt-3 leading-relaxed text-muted">{faq.answer}</p>
</details>
