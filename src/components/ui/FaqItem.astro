---
import type { FaqEntry } from "@data/faq";

export interface Props {
  faq: FaqEntry;
  index?: number;
}

const { faq, index = 0 } = Astro.props;
const code = `Q.${String(index + 1).padStart(2, "0")}`;
---

<details class="faq group border-b border-line" data-animate>
  <summary
    class="flex cursor-pointer list-none items-baseline gap-5 py-6 text-left marker:content-none hover:text-signal [&::-webkit-details-marker]:hidden"
  >
    <span class="mono-label-sm shrink-0 text-signal">{code}</span>
    <span class="display-md flex-1 text-step-1 text-ink group-hover:text-signal">{faq.question}</span>
    <span class="faq-sign mono-label shrink-0 text-step-1 text-muted" aria-hidden="true"></span>
  </summary>
  <p class="max-w-2xl pb-7 pl-12 text-muted leading-relaxed sm:pl-14">{faq.answer}</p>
</details>
