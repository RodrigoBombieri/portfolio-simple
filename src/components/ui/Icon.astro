---
import { ICONS } from "@data/icons";

export interface Props {
  name: keyof typeof ICONS | string;
  class?: string;
  strokeWidth?: number;
  fill?: "none" | "currentColor";
}

const {
  name,
  class: className = "size-6",
  strokeWidth = 1.25,
  fill = "none",
  ...rest
} = Astro.props;

// pathLength="1" en cada trazo permite redibujar el ícono con stroke-dashoffset
// (ver .icon-draw en global.css) sin conocer la longitud real de cada path.
const path = (ICONS[name] ?? "").replace(
  /<(path|circle|rect|line|polyline|polygon)\b/g,
  '<$1 pathLength="1"'
);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill={fill}
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={`icon-draw ${className}`}
  aria-hidden="true"
  {...rest}
  set:html={path}
/>
