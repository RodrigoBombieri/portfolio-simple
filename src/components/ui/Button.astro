---
import Icon from "@components/ui/Icon.astro";

export interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  icon?: string;
  class?: string;
  target?: string;
  rel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  icon,
  class: className = "",
  target,
  rel,
} = Astro.props;

const base =
  "group relative inline-flex items-center justify-center gap-3 whitespace-nowrap font-medium transition-colors duration-200 ease-out";

const sizes = {
  md: "px-5 py-2.5 text-sm",
  lg: "px-7 py-4 text-base",
};

// primary: bloque verde sólido · secondary: borde de plano · ghost: link con subrayado que se dibuja
const variants = {
  primary: "rounded-xs bg-signal text-bg hover:bg-ink",
  secondary: "rounded-xs border border-line text-ink hover:border-signal hover:text-signal",
  ghost: "px-0 text-ink hover:text-signal",
};
const sizeClass = variant === "ghost" ? "py-2 text-sm" : sizes[size];
---

<a
  href={href}
  target={target}
  rel={rel}
  class={`${base} ${sizeClass} ${variants[variant]} ${className}`}
>
  <span class:list={[variant === "ghost" ? "link-draw pb-0.5" : ""]}>
    <slot />
  </span>
  {icon && <Icon name={icon} class="btn-tick size-4" strokeWidth={1.5} />}
</a>
