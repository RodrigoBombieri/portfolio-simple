---
import "@styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { SITE } from "@data/site";
import { TECHNOLOGIES } from "@data/tech";
import { PROJECTS } from "@data/projects";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Desarrollo de Software a Medida | Landing Pages, Apps y Drones",
  description = "Desarrollo landing pages, aplicaciones web, software de escritorio y soluciones para drones a medida en Argentina y Latinoamérica. Software que ahorra tiempo, dinero y reduce tareas repetitivas.",
  image = "/og-image.png",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const portfolioURL = new URL("#portfolio-tecnico", canonicalURL).toString();

// Datos estructurados pensados para reclutadores/equipos técnicos: no se
// muestran en pantalla (la sección visual es deliberadamente discreta), pero
// le dan a Google y a las herramientas de sourcing una versión completa del
// stack y los repositorios sin restarle protagonismo a la propuesta de
// servicios en el contenido visible.
const projectsWithRepo = PROJECTS.filter((p) => p.url);
---

<!doctype html>
<html lang="es" class="js" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Fija el tema antes del primer paint para evitar flash de contenido.
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          /* localStorage no disponible: se mantiene el tema oscuro por defecto */
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="me" href={SITE.github} />
    <link rel="me" href={SITE.linkedin} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Preconnect fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Rodrigo — Desarrollo de Software" />
    <meta name="theme-color" content="#05070d" id="theme-color-meta" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Software a Medida" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        name: "Software a Medida — Rodrigo",
        description,
        url: canonicalURL.toString(),
        areaServed: ["Argentina", "Latinoamérica"],
        priceRange: "$$",
        serviceType: [
          "Desarrollo de Landing Pages",
          "Aplicaciones Web",
          "Aplicaciones de Escritorio",
          "Software a medida",
          "Automatización de procesos",
          "Software para drones",
        ],
      })}
    />

    <!-- Structured data: perfil técnico (para reclutadores / búsqueda de talento) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Rodrigo Bombieri",
        jobTitle: "Desarrollador de Software Full Stack",
        url: canonicalURL.toString(),
        image: ogImageURL.toString(),
        email: SITE.email,
        sameAs: [SITE.github, SITE.linkedin],
        knowsAbout: TECHNOLOGIES.map((tech) => tech.name),
        mainEntityOfPage: portfolioURL,
      })}
    />

    <!-- Structured data: repositorios del portfolio técnico -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Portfolio técnico — proyectos con código disponible",
        url: portfolioURL,
        itemListElement: projectsWithRepo.map((project, i) => ({
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "SoftwareSourceCode",
            name: project.title,
            description: project.description,
            codeRepository: project.url,
            programmingLanguage: project.tags,
          },
        })),
      })}
    />

    <meta name="generator" content={Astro.generator} />
    <Analytics />
  </head>
  <body class="bg-bg antialiased selection:bg-primary">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[999] focus:rounded-lg focus:bg-cyan focus:px-4 focus:py-2 focus:text-bg focus:font-semibold"
    >
      Saltar al contenido principal
    </a>
    <slot />
    <script>
      import "@scripts/main";
    </script>
  </body>
</html>
