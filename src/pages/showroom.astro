---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/sections/Navbar.astro";
import CTA from "@components/sections/CTA.astro";
import Footer from "@components/sections/Footer.astro";
import Icon from "@components/ui/Icon.astro";
import FigureLabel from "@components/ui/FigureLabel.astro";
import ShowroomCard from "@components/ui/ShowroomCard.astro";
import { SHOWROOM_CATEGORIES } from "@data/showroom";

// Etiquetas cortas para las pestañas y para el encabezado de cada lámina
const SHORT: Record<string, string> = {
  web: "Web",
  escritorio: "Escritorio",
  mobile: "Mobile",
  landing: "Landing",
};
const total = SHOWROOM_CATEGORIES.reduce((acc, c) => acc + c.items.length, 0);
let counter = 0;
---

<Layout
  title="Showroom | Ejemplos de proyectos — Rodrigo Bombieri"
  description="Ejemplos reales de landing pages, aplicaciones web, software de escritorio y apps mobile desarrollados a medida."
>
  <Navbar />
  <main id="main-content" class="pt-24 lg:pt-28">
    <section class="relative overflow-hidden">
      <div class="reticle pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto flex max-w-7xl flex-col gap-10 px-6 pb-14 pt-10 lg:px-8 lg:pb-20 lg:pt-14">
        <div class="flex flex-col gap-3" data-animate>
          <FigureLabel n="S" label="Láminas — Showroom" />
          <div class="h-px w-full bg-line" data-draw></div>
        </div>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
          <h1 class="display text-[clamp(2.25rem,5vw,4.75rem)] text-ink lg:col-span-8" data-reveal>
            Ejemplos reales de <span class="text-muted">cada tipo de proyecto.</span>
          </h1>
          <p class="text-pretty leading-relaxed text-muted lg:col-span-4 lg:self-end" data-animate>
            Una muestra de lo que puedo construir para vos: aplicaciones web, software de escritorio, apps mobile y
            landing pages. Las láminas marcadas "Vivo" son mockups reales e interactivos, no capturas: hacé click para
            abrirlas.
          </p>
        </div>
      </div>
      <div class="ruler relative" aria-hidden="true"></div>
    </section>

    <!-- Filtros por tipo -->
    <div class="sticky top-[46px] z-30 border-b border-line bg-bg">
      <div class="mx-auto flex max-w-7xl gap-0 overflow-x-auto px-6 lg:px-8" role="group" aria-label="Filtrar por tipo de proyecto">
        <button type="button" class="mono-label-sm shrink-0 border-x border-line px-5 py-4 text-muted transition-colors hover:text-ink data-[active=true]:bg-bg-soft data-[active=true]:text-signal" data-filter="all" data-active="true" aria-pressed="true">
          Todos [{total}]
        </button>
        {
          SHOWROOM_CATEGORIES.map((category) => (
            <button type="button" class="mono-label-sm shrink-0 border-r border-line px-5 py-4 text-muted transition-colors hover:text-ink data-[active=true]:bg-bg-soft data-[active=true]:text-signal" data-filter={category.id} data-active="false" aria-pressed="false">
              {SHORT[category.id] ?? category.label} [{category.items.length}]
            </button>
          ))
        }
      </div>
    </div>

    {
      SHOWROOM_CATEGORIES.map((category) => (
        <section id={category.id} class="relative scroll-mt-28 border-b border-line py-14 lg:py-16" data-category-section={category.id}>
          <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mb-10 flex items-center gap-4" data-animate>
              <Icon name={category.icon} class="size-7 text-ink" />
              <h2 class="display-md text-step-2 text-ink">{category.label}</h2>
              <span class="mono-label-sm ml-auto text-muted">[{category.items.length}]</span>
            </div>

            <div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
              {category.items.map((item) => {
                counter += 1;
                return <ShowroomCard item={item} n={counter} categoryId={category.id} categoryTag={SHORT[category.id] ?? category.label} />;
              })}
            </div>
          </div>
        </section>
      ))
    }

    <CTA />
  </main>
  <Footer />

  <!-- Modal compartido para los mockups embebidos en vivo (ver ShowroomCard + mockupEmbeds.ts) -->
  <div
    class="fixed inset-0 z-100 hidden items-center justify-center bg-bg/95 p-4 sm:p-8"
    data-mockup-modal
  >
    <div class="relative flex h-[88vh] w-full max-w-[1280px] flex-col overflow-hidden border border-line bg-bg-elevated">
      <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
        <span class="mono-label text-ink" data-mockup-modal-title></span>
        <button
          type="button"
          class="mono-label-sm flex items-center gap-2 border border-line px-3 py-1.5 text-muted transition-colors hover:border-signal hover:text-signal"
          data-mockup-modal-close
          aria-label="Cerrar vista interactiva"
        >
          Cerrar <Icon name="close" class="size-3.5" strokeWidth={1.5} />
        </button>
      </div>
      <div class="relative flex-1 overflow-hidden bg-bg" data-mockup-modal-viewport>
        <iframe data-mockup-modal-frame src="about:blank" title="Mockup interactivo" class="border-0 bg-bg"></iframe>
      </div>
    </div>
  </div>
</Layout>
