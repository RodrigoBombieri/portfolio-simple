---
import Layout from "@layouts/Layout.astro";
import Navbar from "@components/sections/Navbar.astro";
import CTA from "@components/sections/CTA.astro";
import Footer from "@components/sections/Footer.astro";
import Button from "@components/ui/Button.astro";
import FigureLabel from "@components/ui/FigureLabel.astro";
import ExperimentalBadge from "@components/ui/ExperimentalBadge.astro";
import Icon from "@components/ui/Icon.astro";
import DroneScene from "@components/drones/DroneScene.astro";
import { SHOW_DRONES } from "@data/site";
import { DRONE_PAGE } from "@data/droneScene";

// Si la línea de drones está oculta, la página no se expone.
if (!SHOW_DRONES) return Astro.redirect("/");
---

<Layout title={DRONE_PAGE.meta.title} description={DRONE_PAGE.meta.description}>
  <Navbar />
  <main id="main-content" class="pt-24 lg:pt-28">
    <section class="relative overflow-hidden">
      <div class="reticle pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto flex max-w-7xl flex-col gap-10 px-6 pb-14 pt-10 lg:px-8 lg:pb-20 lg:pt-14">
        <div class="flex flex-col gap-3" data-animate>
          <FigureLabel n={DRONE_PAGE.figure} label={DRONE_PAGE.figureLabel} />
          <div class="h-px w-full bg-line" data-draw></div>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
          <div class="flex flex-col gap-7 lg:col-span-7">
            <ExperimentalBadge />
            <h1 class="display text-[clamp(2.25rem,5vw,4.75rem)] text-ink" data-reveal>
              {DRONE_PAGE.title} <span class="text-muted">{DRONE_PAGE.titleMuted}</span>
            </h1>
            <p class="max-w-xl text-pretty leading-relaxed text-muted" data-animate>{DRONE_PAGE.description}</p>
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center" data-animate>
              <Button href="/#contacto" size="lg" icon="arrow-right">{DRONE_PAGE.cta}</Button>
              <Button href="#escenario" variant="ghost" icon="arrow-right">{DRONE_PAGE.secondary}</Button>
            </div>
          </div>

          <div class="flex flex-col gap-6 lg:col-span-4 lg:col-start-9 lg:self-end" data-animate>
            <p class="mono-label-sm flex items-start gap-3 text-warn">
              <Icon name="flask" class="mt-0.5 size-4 shrink-0" strokeWidth={1.5} />
              {DRONE_PAGE.note}
            </p>
            <dl class="grid grid-cols-3 border-l border-t border-line">
              {
                DRONE_PAGE.specs.map((spec) => (
                  <div class="flex flex-col gap-1 border-b border-r border-line px-3 py-3">
                    <dt class="mono-label-sm text-muted">{spec.k}</dt>
                    <dd class="mono-label text-ink">{spec.v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
      <div class="ruler relative" aria-hidden="true"></div>
    </section>

    <DroneScene />

    <CTA />
  </main>
  <Footer />
</Layout>
